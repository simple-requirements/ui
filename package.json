{
    "name": "requirements-ui",
    "version": "0.1.0",
    "description": "A small requirements management app.",
    "main": "out/main/index.js",
    "author": "Florian Weidinger",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "api:generate": "orval --config ./orval.config.ts",
        "dev": "vite dev",
        "build": "tsc --noEmit && vite build",
        "docs": "typedoc",
        "format": "prettier --write .",
        "lint": "eslint .",
        "preview": "vite preview",
        "test:unit": "vitest",
        "test:unit:coverage": "vitest run --coverage",
        "test:e2e": "pnpm run build:e2e && bddgen && playwright test",
        "test:e2e:ui": "pnpm run build:e2e && bddgen && playwright test --ui",
        "build:e2e": "tsc --noEmit && vite build --mode e2e"
    },
    "dependencies": {
        "@git-diff-view/react": "^0.1.6",
        "@tanstack/query-db-collection": "^1.0.44",
        "@tanstack/react-db": "^0.1.90",
        "@tanstack/react-query": "^5.101.0",
        "@tanstack/react-store": "^0.11.0",
        "primeicons": "^7.0.0",
        "primereact": "^10.9.8",
        "react": "^19.2",
        "react-dom": "^19.2",
        "react-router": "^8.0.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/compat": "^2.1.0",
        "@eslint/config-helpers": "^0.6.0",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.60.0",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^24.13.1",
        "@types/react": "^19.2",
        "@types/react-dom": "^19.2",
        "@vitejs/plugin-react": "^5.2.0",
        "@vitest/coverage-istanbul": "^4.1.8",
        "eslint": "^10.4.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.2",
        "jiti": "^2.7.0",
        "jsdom": "^29.1.1",
        "npm-run-all2": "^9.0.1",
        "orval": "^8.19.0",
        "playwright": "^1.60.0",
        "playwright-bdd": "^9.0.0",
        "prettier": "^3.8.3",
        "sass-embedded": "^1.100.0",
        "typedoc": "^0.28.19",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.60.1",
        "vite": "^7.3.5",
        "vitest": "^4.1.8"
    },
    "pnpm": {
        "overrides": {
            "@tanstack/db": "0.6.12"
        }
    }
}
